# Copy to .env and adjust.

# SQLite for local development; swap to Postgres for production.
DATABASE_URL="file:./dev.db"

# Server-side key for the Pi Platform API (from the Pi Developer Portal).
# Leave empty for demo mode: purchases complete without real Pi transactions.
PI_API_KEY=""

# Secret for signing session cookies. Set a long random value in production.
SESSION_SECRET=""

# Set to 1 in production to turn off the demo investor/agent sign-in.
DEMO_LOGIN_DISABLED=""
